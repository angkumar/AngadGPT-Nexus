# Clerk instance issuer URL, for example https://example.clerk.accounts.dev
CLERK_ISSUER_URL=REPLACE_WITH_CLERK_ISSUER_URL
# Optional custom JWKS endpoint; leave blank to use issuer/.well-known/jwks.json
CLERK_JWKS_URL=
# Optional audience, if configured in your Clerk session token template
CLERK_AUDIENCE=
ANGADGPT_AUTH_MODE=clerk
ANGADGPT_USER_DATA_DIR=memory/users
ANGADGPT_ALLOWED_ORIGINS=http://localhost:5173
